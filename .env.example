# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Dataset Paths
DRIVE_DATASET_PATH=/path/to/dataset_dati_comuni

# Output Configuration
OUTPUT_ROOT=./Comuni

# Logging
LOG_LEVEL=INFO

# Cache Configuration
CACHE_TTL=86400
CACHE_ENABLED=true

# HTTP Configuration
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Crawling Configuration
MAX_PAGES=200
CRAWL_DEPTH=3
RATE_LIMIT=1.0
